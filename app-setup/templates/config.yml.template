# NOTE: This template is for reference/documentation only. The authoritative
# generator is write_config() in app-setup/transmission-filebot-setup.sh —
# update that function first, then mirror the change here to keep them in sync.
---
version: 1.0
paths:
  default_home: /Users/__OPERATOR_USERNAME__
plex:
  server: http://localhost:32400
  token: __PLEX_TOKEN__
  media_path: __PLEX_MEDIA_PATH__
  movie_section_id: __PLEX_MOVIE_SECTION_ID__
  tv_section_id: __PLEX_TV_SECTION_ID__
alerts:
  email: __MONITORING_EMAIL__  # optional; omitted when MONITORING_EMAIL is unset
logging:
  file: .local/state/transmission-processing.log
  max_size: 10485760
